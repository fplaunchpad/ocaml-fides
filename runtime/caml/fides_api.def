/**************************************************************************/
/*                                                                        */
/*                                 OCaml                                  */
/*                                                                        */
/*   FIDES software sanitizer: the OCaml C API as sanitized C sees it.    */
/*   See Implementation/DECISIONS.md (Stage 4).                           */
/*                                                                        */
/**************************************************************************/

/* The single list of OCaml C API functions that sanitized C reaches
   through a wrapper. It is included by the runtime (runtime/fides_api.c:
   the wrappers' type checks and the address-to-wrapper table; runtime/fides.c:
   the revision symbol) and by the LLVM pass (pass/FidesSanitizer.cpp: the
   names it redirects). Each includer defines the macros it needs; the rest
   default to nothing.

   FIDES_WRAP(name)  sanitized C calls caml_fides_w_<name> instead: a wrapper
                     in the trusted runtime with the same C type, which checks
                     and strips tagged value arguments, checks pointer
                     arguments, and calls the real function.
   FIDES_PASS(name)  sanitized C calls the function itself: its type has no
                     `value`, so there is nothing to check (pointer arguments
                     are decoded by the pass, as for libc).
   FIDES_SELF(name)  the function checks its tagged arguments itself (D12's
                     root interface); the pass leaves them tagged.

   Every other function the runtime library defines is refused at compile
   time: caml/fides_api_deny.def, generated by scripts/gen-fides-api-deny.sh
   from libasmrun.a and checked by tests/pass/api_coverage.sh.

   Bump FIDES_API_REVISION when the list changes: a plugin built against one
   revision then fails to link against a runtime of another. */

#ifndef FIDES_API_REVISION
#define FIDES_API_REVISION(n)
#endif
#ifndef FIDES_WRAP
#define FIDES_WRAP(name)
#endif
#ifndef FIDES_PASS
#define FIDES_PASS(name)
#endif
#ifndef FIDES_SELF
#define FIDES_SELF(name)
#endif

FIDES_API_REVISION(5)

/* Reading a value */
FIDES_WRAP(caml_string_length)
FIDES_WRAP(caml_string_is_c_safe)
FIDES_WRAP(caml_array_length)
FIDES_WRAP(caml_named_value)
FIDES_WRAP(caml_hash_variant)

/* GC primitives a stub may call directly (Gc.minor and friends) */
FIDES_WRAP(caml_gc_minor)
FIDES_WRAP(caml_gc_major)
FIDES_WRAP(caml_gc_full_major)
FIDES_WRAP(caml_gc_compaction)

/* Callbacks. Arguments are checked and stripped; whether the callback also
   revokes their entries is open question E (waiting for the PI). Results
   are handed to C bare (DECISIONS.md D14). */
FIDES_WRAP(caml_callback)
FIDES_WRAP(caml_callback2)
FIDES_WRAP(caml_callback3)
FIDES_WRAP(caml_callbackN)
FIDES_WRAP(caml_callback_exn)
FIDES_WRAP(caml_callback2_exn)
FIDES_WRAP(caml_callback3_exn)
FIDES_WRAP(caml_callbackN_exn)
FIDES_WRAP(caml_callback_res)
FIDES_WRAP(caml_callback2_res)
FIDES_WRAP(caml_callback3_res)
FIDES_WRAP(caml_callbackN_res)

/* Field stores (Store_field and friends): the destination must be a field C
   may write, the value must pass the value check, and it is stored demoted
   (DECISIONS.md D15). */
FIDES_WRAP(caml_modify)
FIDES_WRAP(caml_initialize)

/* Allocation: the new block is handed to C tagged, with an entry over
   exactly the block, owned by the activation (DECISIONS.md D16). Values
   stored into it are checked and demoted. */
FIDES_WRAP(caml_alloc)
FIDES_WRAP(caml_alloc_small)
FIDES_WRAP(caml_alloc_tuple)
FIDES_WRAP(caml_alloc_string)
FIDES_WRAP(caml_alloc_initialized_string)
FIDES_WRAP(caml_alloc_float_array)
FIDES_WRAP(caml_alloc_1)
FIDES_WRAP(caml_alloc_2)
FIDES_WRAP(caml_alloc_3)
FIDES_WRAP(caml_alloc_4)
FIDES_WRAP(caml_alloc_5)
FIDES_WRAP(caml_alloc_6)
FIDES_WRAP(caml_alloc_7)
FIDES_WRAP(caml_alloc_8)
FIDES_WRAP(caml_alloc_9)
FIDES_WRAP(caml_alloc_some)
FIDES_WRAP(caml_copy_string)
FIDES_WRAP(caml_copy_double)
FIDES_WRAP(caml_copy_int32)
FIDES_WRAP(caml_copy_int64)
FIDES_WRAP(caml_copy_nativeint)
FIDES_WRAP(caml_alloc_custom)
FIDES_WRAP(caml_alloc_custom_mem)
/* ... with values or pointers nested in their arguments */
FIDES_WRAP(caml_copy_string_array)
FIDES_WRAP(caml_alloc_array)
FIDES_WRAP(caml_alloc_sprintf)

/* Primitives that write into a block C names (DECISIONS.md D17). Before
   they were wrapped, a forged bare address made them write anywhere. */
FIDES_WRAP(caml_bytes_set)
FIDES_WRAP(caml_string_set)
FIDES_WRAP(caml_bytes_set16)
FIDES_WRAP(caml_bytes_set32)
FIDES_WRAP(caml_bytes_set64)
FIDES_WRAP(caml_fill_bytes)
FIDES_WRAP(caml_blit_bytes)
FIDES_WRAP(caml_blit_string)
FIDES_WRAP(caml_array_set)
FIDES_WRAP(caml_array_unsafe_set)
FIDES_WRAP(caml_floatarray_set)
FIDES_WRAP(caml_floatarray_unsafe_set)

/* Raising an exception that carries a value */
FIDES_WRAP(caml_raise)
FIDES_WRAP(caml_raise_constant)
FIDES_WRAP(caml_raise_with_arg)
FIDES_WRAP(caml_raise_with_args)
FIDES_WRAP(caml_raise_with_string)
FIDES_WRAP(caml_failwith_value)
FIDES_WRAP(caml_invalid_argument_value)
FIDES_WRAP(caml_raise_sys_error)

/* No value in their types: called as they are. */
FIDES_PASS(caml_failwith)
FIDES_PASS(caml_invalid_argument)
FIDES_PASS(caml_raise_out_of_memory)
FIDES_PASS(caml_raise_stack_overflow)
FIDES_PASS(caml_raise_end_of_file)
FIDES_PASS(caml_raise_zero_divide)
FIDES_PASS(caml_raise_not_found)
FIDES_PASS(caml_array_bound_error)
FIDES_PASS(caml_raise_sys_blocked_io)
FIDES_PASS(caml_minor_collection)
FIDES_PASS(caml_process_pending_actions)
FIDES_PASS(caml_enter_blocking_section)
FIDES_PASS(caml_leave_blocking_section)
FIDES_PASS(caml_bad_caml_state)          /* CAMLparam's Caml_check_caml_state */
FIDES_PASS(caml_check_error)
FIDES_PASS(caml_alloc_dependent_memory)
FIDES_PASS(caml_free_dependent_memory)
FIDES_PASS(caml_custom_get_max_major)
FIDES_PASS(caml_register_custom_operations)
FIDES_PASS(caml_hash_mix_uint32)
FIDES_PASS(caml_hash_mix_intnat)
FIDES_PASS(caml_hash_mix_int64)
FIDES_PASS(caml_hash_mix_double)
FIDES_PASS(caml_hash_mix_float)
/* The runtime's C allocator: results are bare (a known false positive, as
   for libc allocations: DECISIONS.md section 4). */
FIDES_PASS(caml_stat_alloc)
FIDES_PASS(caml_stat_alloc_noexc)
FIDES_PASS(caml_stat_calloc_noexc)
FIDES_PASS(caml_stat_resize)
FIDES_PASS(caml_stat_resize_noexc)
FIDES_PASS(caml_stat_free)
FIDES_PASS(caml_stat_strdup)
FIDES_PASS(caml_stat_strdup_noexc)
FIDES_PASS(caml_stat_strconcat)

/* D12's root interface. */
FIDES_SELF(caml_checked_roots_mark)
FIDES_SELF(caml_checked_roots_register)
FIDES_SELF(caml_checked_roots_restore)
FIDES_SELF(caml_checked_register_global_root)
FIDES_SELF(caml_checked_remove_global_root)
FIDES_SELF(caml_checked_register_generational_global_root)
FIDES_SELF(caml_checked_remove_generational_global_root)
FIDES_SELF(caml_checked_modify_generational_global_root)

#undef FIDES_API_REVISION
#undef FIDES_WRAP
#undef FIDES_PASS
#undef FIDES_SELF
